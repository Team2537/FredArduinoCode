#include <Adafruit_NeoPixel.h>

#define PIN 3
#define NUM_OF_LEDS 56

Adafruit_NeoPixel strip = Adafruit_NeoPixel(56, PIN, NEO_GRB + NEO_KHZ800);

int randomNumber;
int red[56];
int green[56];
int blue[56];
int sensorPin = A0;
int sensorValue = 0;
int select = 0;
int i, j;
int element[8][3];

void setup() {
  // put your setup code here, to run once:
  strip.begin();
  strip.setBrightness(100);
  strip.show(); // Initialize all pixels to 'off'
  randomSeed(13240987123409907312349923498745760202011025098732459087743929);
  Serial.begin(9600);
}

boolean check() {
  boolean change = false;
  int sensorValue = analogRead(sensorPin);

  if (sensorValue < 512) {
    return true;
  }

  delay(67);
  return false;
}

void setStrip(int r, int g, int b) {
  for (int i = 0; i < NUM_OF_LEDS; i++) {
    strip.setPixelColor(i, r, g, b);
  }
  strip.show();
}

void peePeePooPooPartyMode() {
  for (int i = 0; i < NUM_OF_LEDS; i += 1) {
    strip.setPixelColor(i, i*random(3)*1000, i*random(3)*1000, i*random(3)*1000);
    strip.show();
  }

  delay(00);

  // for (int i = 1; i < NUM_OF_LEDS - 2; i += 2) {
  //   strip.setPixelColor(i, 0, 255, 0);
  //   strip.show();
  // }
}

int mode = 1;

void loop() {
  delay(500);

  if (check()) {
    mode++;
    Serial.print("Mode: ");
    Serial.println(mode);
  }

  if (mode == 1) { // Cleaer
    setStrip(0, 0, 0);
  }

  if (mode == 2) { // Rid
    setStrip(255, 0, 0);
  }

  if (mode == 3) { // Bloo
    setStrip(0, 0, 255);
  }

  if (mode == 4) { // Grin
    setStrip(0, 254, 0);
  }

  if (mode == 5){
    peePeePooPooPartyMode();
  }

  if (mode == 6) {
    setStrip(0, 0, 0);
  }

  if (mode > 6) {
    mode = 1;
  }
}
